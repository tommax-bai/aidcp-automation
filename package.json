{
  "name": "aidcp-automation",
  "version": "0.1.0",
  "private": true,
  "description": "aidcp-automation —— 边缘 WS / 风控单写 / 编排 / 通知巡视（属主库 aidcp_automation）",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'",
    "test:acceptance": "tsx --test test/acceptance/*.test.ts",
    "test:pg": "AIDCP_PG_INTEGRATION=1 tsx --test 'test/**/*.integration.test.ts'",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "boundaries:refresh": "tsx test/acceptance/helpers/boundary-record.ts refresh",
    "boundaries:census": "tsx test/acceptance/helpers/boundary-record.ts census",
    "start": "tsx --env-file=.env src/server.ts",
    "trigger:like": "tsx src/cli/trigger-like.ts",
    "test:feishu": "tsx --env-file=.env src/cli/test-feishu.ts"
  },
  "dependencies": {
    "aidcp-kernel": "git+ssh://git@github.com/tommax-bai/aidcp-kernel.git#add87e5eab8f2fc8086cd9e1fff1ef3a8de6390c",
    "aidcp-transport": "git+ssh://git@github.com/tommax-bai/aidcp-transport.git#3ca819717daa90da0d6749848b26ffd01e6564cd",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
